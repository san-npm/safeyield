# APY History Index Hash (from collector output)
# Set this to enable real APY sparklines from IPFS.
# Without this, sparklines will show simulated data.
# This file is auto-rewritten by the hourly APY collector workflow;
# the bot's value reflects whether the Aleph upload succeeded
# (real Aleph CID = real history, "local-..." prefix = SDK error fallback).
NEXT_PUBLIC_HISTORY_INDEX_HASH=

# RealToken (RMM) API key for tokenized real-estate yields on Gnosis.
# If unset, RealT pools are skipped. Request a key at https://realtoken.community.
NEXT_PUBLIC_REALT_API_KEY=
