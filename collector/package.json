{
  "name": "yiield-apy-collector",
  "version": "1.0.0",
  "description": "APY history collector for Yiield - stores data on Aleph/IPFS",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "collect": "npx tsx src/index.ts",
    "dev": "npx tsx --watch src/index.ts",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@aleph-sdk/account": "^1.7.4",
    "@aleph-sdk/client": "^1.7.4",
    "@aleph-sdk/core": "^1.7.4",
    "@aleph-sdk/ethereum": "^1.8.0",
    "@aleph-sdk/message": "^1.7.5",
    "decimal.js": "^10.6.0",
    "dotenv": "^17.2.3"
  },
  "devDependencies": {
    "@types/node": "^20.12.12",
    "tsx": "^4.19.2",
    "typescript": "^5.4.5"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
